[Unit]
Description=TV controller service (Joy-Cons, Pro Controller)
After=bluetooth.service

[Service]
Type=exec
# The user's own account, plus the one group that may open the Joy-Cons' device nodes
# (72-tv-joycon.rules). Steam and everything else in the session run without that group.
User=deck
Group=deck
SupplementaryGroups=input
# Sending one HCI command, the link policy that keeps a Joy-Con's connection out of sniff
# mode while it rumbles (Bluetooth::setSniffAllowed), needs this; nothing else does.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
# The shell talks to the service on the user's session bus.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/home/deck/.local/share/tvcontrollers/tvcontrollers
# Also after a clean exit: a deploy restarts the service by ending its process.
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target

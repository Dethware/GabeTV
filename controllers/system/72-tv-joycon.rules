# Nintendo's Switch controllers over Bluetooth belong to the TV's controller service alone:
# Joy-Cons (left 057e:2006, right 057e:2007) and the Pro Controller (057e:2009). No access
# for the logged-in user (Steam, SDL programs), only for group "input". Sorted after
# 70-steam-jupiter-input.rules and 70-uaccess.rules, which tag the nodes for user access,
# and before 73-seat-late.rules, which applies that tag.
# A Pro Controller on a USB cable is not covered: the service doesn't speak to it that way.

# The raw HID node.
SUBSYSTEM=="hidraw", KERNELS=="0005:057E:200[679].*", TAG-="uaccess", GROUP="input", MODE="0660"

# The generic driver's input devices for them.
SUBSYSTEM=="input", KERNEL=="event*|js*", ATTRS{id/bustype}=="0005", ATTRS{id/vendor}=="057e", ATTRS{id/product}=="200[679]", TAG-="uaccess", GROUP="input", MODE="0660"

{
  "name": "Steam virtual gamepad",
  "idmatcher": "Microsoft X-Box 360 pad.*",
  "mapping":
  {
    // A
    "KEY_BUTTON_0": "enter",

    // B
    "KEY_BUTTON_1": {
      "short": "back",
      "long": "home"
    },

    // X
    "KEY_BUTTON_2": "play_pause",

    // Y
    "KEY_BUTTON_3": "search",

    // LB, RB
    "KEY_BUTTON_4": "seek_backward",
    "KEY_BUTTON_5": "seek_forward",

    // View, Menu
    "KEY_BUTTON_6": "",
    "KEY_BUTTON_7": "play_pause",

    // D-pad
    "KEY_HAT_DOWN": "down",
    "KEY_HAT_UP": "up",
    "KEY_HAT_RIGHT": "right",
    "KEY_HAT_LEFT": "left"

    // The sticks are left out on purpose: a sideways push also reports a little up or down,
    // which the player takes as a second direction.
  }
}
